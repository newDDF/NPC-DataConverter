const renderDataTable = (
  rows: Record<string, any>[],
  emptyMessage: string
) => {
  if (rows.length === 0) {
    return (
      <div className="flex flex-1 min-h-0 items-center justify-center rounded-xl border border-dashed border-slate-300 dark:border-slate-700 p-6 text-center text-xs text-slate-500 dark:text-slate-400">
        {emptyMessage}
      </div>
    );
  }

  const columns = Array.from(
    new Set(rows.flatMap((row) => Object.keys(row)))
  );

  if (columns.length === 0) {
    return (
      <div className="flex flex-1 min-h-0 items-center justify-center text-xs text-slate-500">
        No tabular fields found.
      </div>
    );
  }

  const formatCell = (value: unknown): string => {
    if (value === null || value === undefined) return '';
    if (typeof value === 'object') {
      return JSON.stringify(value) ?? String(value);
    }
    return String(value);
  };

  const measureTextWidth = (value: string): number =>
    Array.from(value).reduce((width, char) => {
      const code = char.codePointAt(0) ?? 0;
      const isWide =
        /[\u1100-\u11FF\u2E80-\uA4CF\uAC00-\uD7AF\uF900-\uFAFF\uFE10-\uFE6F\uFF00-\uFF60\uFFE0-\uFFE6]/u.test(char) ||
        code > 0x1f000;

      return width + (isWide ? 12 : 6.5);
    }, 0);

  const columnWidths = columns.map((column) => {
    let maxWidth = measureTextWidth(column);

    for (const row of rows) {
      const width = measureTextWidth(formatCell(row[column]));
      maxWidth = Math.max(maxWidth, width);
    }

    return Math.min(280, Math.max(80, Math.ceil(maxWidth + 24)));
  });

  return (
    <div className="flex-1 min-h-0 min-w-0 flex flex-col overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800">
      <div className="flex-1 min-h-0 min-w-0 overflow-auto overscroll-contain">
        <table className="w-max min-w-full table-auto border-collapse text-left text-xs">
          <colgroup>
            {columns.map((column, index) => (
              <col key={column} style={{ width: `${columnWidths[index]}px` }} />
            ))}
          </colgroup>
          <thead className="sticky top-0 z-10 bg-slate-100 dark:bg-slate-800">
            <tr>
              {columns.map((column) => (
                <th
                  key={column}
                  className="min-w-[80px] max-w-[280px] whitespace-normal break-words border-b border-slate-200 dark:border-slate-700 px-3 py-2 font-semibold text-slate-700 dark:text-slate-200"
                >
                  {column}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map((row, rowIndex) => (
              <tr
                key={rowIndex}
                className="border-b border-slate-100 dark:border-slate-800 last:border-0 hover:bg-slate-50 dark:hover:bg-slate-800/60"
              >
                {columns.map((column) => (
                  <td
                    key={column}
                    className="min-w-[80px] max-w-[280px] border-b border-slate-100 dark:border-slate-800 px-3 py-2 align-top text-slate-600 dark:text-slate-300"
                  >
                    <div className="max-h-24 overflow-auto whitespace-pre-wrap break-words [overflow-wrap:anywhere]">
                      {formatCell(row[column])}
                    </div>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div className="shrink-0 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 px-3 py-2 text-[11px] text-slate-500 dark:text-slate-400">
        {rows.length} record(s) · {columns.length} field(s)
      </div>
    </div>
  );
};

export default function App() {
  const [theme, setTheme] = useState<'dark' | 'light'>('dark');
  const batch = useBatchTasks();
  const [inputBatchOpen, setInputBatchOpen] = useState(false);
  const [previewMode, setPreviewMode] = useState<'single' | 'batch'>('single');
  const [outputBatchOpen, setOutputBatchOpen] = useState(false);
  const [inputFormat, setInputFormat] = useState<InputFormatOption>('auto');
  const [detectedFormat, setDetectedFormat] = useState<DataFormat>('json');
  const [outputFormat, setOutputFormat] = useState<DataFormat>('json');
  const [inputData, setInputData] = useState(SAMPLES.users.data);
  const [outputData, setOutputData] = useState('');
  const [sqlTableName, setSqlTableName] = useState('data');
  const [outputBlob, setOutputBlob] = useState<Blob | null>(null);
  const [recordCount, setRecordCount] = useState(0);
  const [convertedRows, setConvertedRows] = useState<Record<string, any>[]>([]);
  const [isCopied, setIsCopied] = useState(false);

  const [availableFields, setAvailableFields] = useState<string[]>([]);
  const [selectedFields, setSelectedFields] = useState<string[]>([]);
  const [jsonFieldTree, setJsonFieldTree] = useState<JsonFieldNode[]>([]);
  const [jsonFieldSelection, setJsonFieldSelection] = useState<JsonFieldSelection>({});
  const [fieldSearchTerm, setFieldSearchTerm] = useState('');
  const [activeModal, setActiveModal] = useState<'privacy' | 'terms' | null>(null);

  const [inputViewMode, setInputViewMode] = useState<'code' | 'table'>('code');
  const [outputViewMode, setOutputViewMode] = useState<'code' | 'table'>('code');
  const [activeDrag, setActiveDrag] = useState<{
    field: string;
    x: number;
    y: number;
  } | null>(null);

  useEffect(() => {
    if (theme === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  }, [theme]);


  const activeInputFormat = inputFormat === 'auto' ? detectedFormat : inputFormat;

  const [batchPreview, setBatchPreview] = useState('');
  const [batchSqlTableName, setBatchSqlTableName] = useState('data');

  useEffect(() => {
    if (previewMode !== 'batch') return;

    const task = batch.activeTask;

    if (!task) {
      setBatchPreview('');
      return;
    }

    if (task.status === 'processing') {
      setBatchPreview('Conversion in progress...');
      return;
    }

    if (task.status === 'completed' && task.outputText) {
      setBatchPreview(task.outputText);
      return;
    }

    if (!task.sourceFormat) {
      setBatchPreview('Preview unavailable: unsupported source format.');
      return;
    }

    let cancelled = false;
    setBatchPreview('Generating conversion preview...');

    const generatePreview = async () => {
      try {
        const source = await readBatchSource(task.file, task.sourceFormat!);

        const result = convertBatchRows(source.rows, outputFormat, selectedFields, batchSqlTableName);

        if (!cancelled) {
          setBatchPreview(result.text);
        }
      } catch (error) {
        if (!cancelled) {
          setBatchPreview(
            `Preview error: ${error instanceof Error ? error.message : 'Unable to preview this file.'}`
          );
        }
      }
    };

    void generatePreview();

    return () => {
      cancelled = true;
    };
  }, [
    batch.activeTask?.id,
    batch.activeTask?.status,
    batch.activeTask?.outputText,
    batch.activeTask?.sourceFormat,
    outputFormat,
    selectedFields,
    availableFields,
    batchSqlTableName,
    previewMode,
  ]);

  useEffect(() => {
    if (previewMode !== 'batch') return;
    const task = batch.activeTask;
    if (!task) return;

    if (task.sourceData !== undefined) {
      setInputData(task.sourceData);
      const sourceFormat = task.sourceFormat === 'excel' ? 'json' : task.sourceFormat;
      if (sourceFormat) {
        setInputFormat(sourceFormat);
        setDetectedFormat(sourceFormat);
      }
    }

    setOutputData(task.outputText || '');
    setOutputBlob(task.outputBlob);
    setRecordCount(task.recordCount);
    if (task.outputFormat) setOutputFormat(task.outputFormat);

    if (task.outputText && task.outputFormat) {
      try {
        setConvertedRows(parseTextData(task.outputText, task.outputFormat));
      } catch {
        setConvertedRows([]);
      }
    } else {
      setConvertedRows([]);
    }
  }, [
    batch.activeTask?.id,
    batch.activeTask?.sourceData,
    batch.activeTask?.outputText,
    batch.activeTask?.outputFormat,
  ]);


  const handleFileUpload = async (file: File) => {
    const extension = file.name.split('.').pop()?.toLowerCase() ?? '';
    const formats: Record<string, DataFormat> = {
      json: 'json',
      csv: 'csv',
      xml: 'xml',
      yaml: 'yaml',
      yml: 'yaml',
      md: 'md',
      sql: 'sql',
    };

    const supportedExtensions = [...Object.keys(formats), 'xlsx', 'xls'];

    if (!supportedExtensions.includes(extension)) {
      setOutputData(`File import error: Unsupported file type ".${extension}".`);
      return;
    }

    try {
      if (extension === 'xlsx' || extension === 'xls') {
        const buffer = await file.arrayBuffer();
        const rows = parseExcelBuffer(buffer);
        setInputData(JSON.stringify(rows, null, 2));
        setInputFormat('json');
      } else {
        const text = await file.text();
        setInputData(text);
        setInputFormat(formats[extension]);
      }
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Unable to read file';
      setOutputData(`File import error: ${message}`);
    }
  };

  useEffect(() => {
    if (inputFormat === 'auto') {
      setDetectedFormat(detectFormat(inputData));
    }
  }, [inputData, inputFormat]);

  const parseRawToJS = useCallback(
    (raw: string, fmt: DataFormat): Record<string, any>[] => {
      return parseTextData(raw, fmt);
    },
    []
  );

  const inputPreviewRows = useMemo(() => {
    try {
      return parseRawToJS(inputData, activeInputFormat);
    } catch {
      return [];
    }
  }, [inputData, activeInputFormat, parseRawToJS]);

  useEffect(() => {
    try {
      const rows = parseRawToJS(inputData, activeInputFormat);

      if (activeInputFormat === 'json') {
        const tree = buildJsonFieldTree(rows);
        setJsonFieldTree(tree);
        setJsonFieldSelection((previous) => {
          const next = createJsonFieldSelection(tree);
          Object.keys(next).forEach((path) => {
            if (Object.prototype.hasOwnProperty.call(previous, path)) {
              next[path] = previous[path];
            }
          });
          return next;
        });
      } else {
        setJsonFieldTree([]);
        setJsonFieldSelection({});
      }

      if (rows && rows.length > 0) {
        const keysSet = new Set<string>();
        rows.forEach((row) => {
          if (typeof row === 'object' && row !== null) {
            Object.keys(row).forEach((k) => keysSet.add(k));
          }
        });
        const fields = Array.from(keysSet);
        setAvailableFields(fields);
        setSelectedFields((prev) => {
          if (prev.length === 0 || !prev.every(f => fields.includes(f))) {
            return fields;
          }
          return prev;
        });
      } else {
        setAvailableFields([]);
        setSelectedFields([]);
      }
    } catch {
      setAvailableFields([]);
      setSelectedFields([]);
      setJsonFieldTree([]);
      setJsonFieldSelection({});
    }
  }, [inputData, activeInputFormat, parseRawToJS]);

  const handleConvert = () => {
    if (previewMode === 'batch' && inputBatchOpen && batch.tasks.length > 0) {
      void batch.startAll(outputFormat, selectedFields, batchSqlTableName);
      return;
    }

    try {
      const rows = parseRawToJS(inputData, activeInputFormat);
      setRecordCount(rows.length);

      const fields = selectedFields;

      const filtered = activeInputFormat === 'json' && outputFormat === 'json'
        ? filterJsonRows(rows, jsonFieldTree, jsonFieldSelection)
        : rows.map((row) => {
            const result: Record<string, any> = {};
            fields.forEach((field) => {
              if (Object.prototype.hasOwnProperty.call(row, field)) {
                result[field] = row[field];
              }
            });
            return result;
          });

      setConvertedRows(filtered);

      if (outputFormat === 'excel') {
        setOutputBlob(createExcelBlob(filtered));
        setOutputData(
          `Excel workbook ready. ${filtered.length} record(s) will be exported to an .xlsx file.`
        );
      } else {
        setOutputBlob(null);
        setOutputData(
          outputFormat === 'sql'
            ? serializeSQL(filtered, fields, sqlTableName)
            : serializeRows(
                filtered,
                outputFormat,
                activeInputFormat === 'json' && outputFormat === 'json'
                  ? Object.keys(filtered[0] ?? {})
                  : fields
              )
        );
      }
    } catch (error) {
      setOutputBlob(null);
      setRecordCount(0);
      setConvertedRows([]);
      const message = error instanceof Error ? error.message : 'Unknown conversion error';
      setOutputData(`Conversion error: ${message}`);
    }
  };

  useEffect(() => {
    if (previewMode !== 'single') return;
    handleConvert();
  }, [previewMode, inputData, activeInputFormat, outputFormat, selectedFields, availableFields, jsonFieldTree, jsonFieldSelection, parseRawToJS, sqlTableName]);

  const handleCopy = async () => {
    if (!outputData || outputFormat === 'excel') return;

    try {
      await navigator.clipboard.writeText(outputData);
      setIsCopied(true);
      window.setTimeout(() => setIsCopied(false), 2000);
    } catch {
      setIsCopied(false);
    }
  };

  const handleDownload = async () => {
    if (previewMode === 'batch') {
      const completedTasks = batch.tasks.filter(
        (task) => task.status === 'completed' && task.outputFormat
      );

      if (completedTasks.length === 0) return;

      const zip = new JSZip();
      const filenameCounts = new Map<string, number>();

      for (const task of completedTasks) {
        const originalBase = task.name.replace(/\.[^.]+$/, '');
        const extension = getBatchOutputExtension(task.outputFormat!);
        const count = (filenameCounts.get(originalBase) ?? 0) + 1;
        filenameCounts.set(originalBase, count);

        const suffix = count > 1 ? ` (${count})` : '';
        const filename = `${originalBase}${suffix}.${extension}`;
        const blob = task.outputBlob ?? new Blob(
          [task.outputText],
          { type: 'text/plain;charset=utf-8' }
        );

        zip.file(filename, blob);
      }

      const zipBlob = await zip.generateAsync({ type: 'blob' });
      const url = URL.createObjectURL(zipBlob);
      const anchor = document.createElement('a');

      anchor.href = url;
      anchor.download = 'converted_files.zip';
      document.body.appendChild(anchor);
      anchor.click();
      anchor.remove();

      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
      return;
    }

    if (!outputData) return;

    const isExcel = outputFormat === 'excel';
    const blob = isExcel && outputBlob
      ? outputBlob
      : new Blob([outputData], { type: 'text/plain;charset=utf-8' });

    const extension = isExcel ? 'xlsx' : outputFormat;
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement('a');

    anchor.href = url;
    anchor.download = `converted_data.${extension}`;
    document.body.appendChild(anchor);
    anchor.click();
    anchor.remove();

    window.setTimeout(() => URL.revokeObjectURL(url), 1000);
  };

  const handleFieldPointerDown = (
    e: React.PointerEvent<HTMLSpanElement>,
    field: string
  ) => {
    e.preventDefault();
    e.stopPropagation();

    e.currentTarget.setPointerCapture(e.pointerId);

    setActiveDrag({
      field,
      x: e.clientX,
      y: e.clientY,
    });
  };

  const handleFieldPointerMove = (e: React.PointerEvent<HTMLDivElement>) => {
    if (!activeDrag) return;

    setActiveDrag((current) =>
      current
        ? { ...current, x: e.clientX, y: e.clientY }
        : null
    );

    const element = document.elementFromPoint(e.clientX, e.clientY);
    const targetRow = element?.closest<HTMLElement>('[data-field-key]');
    const targetField = targetRow?.dataset.fieldKey;
    const sourceField = activeDrag.field;

    if (!targetField || targetField === sourceField || !targetRow) return;

    const rect = targetRow.getBoundingClientRect();
    const insertAfter = e.clientY > rect.top + rect.height / 2;

    const reorderedFields = [...availableFields];
    const fromIndex = reorderedFields.indexOf(sourceField);

    if (fromIndex < 0) return;

    reorderedFields.splice(fromIndex, 1);

    const targetIndex = reorderedFields.indexOf(targetField);
    if (targetIndex < 0) return;

    const insertIndex = targetIndex + (insertAfter ? 1 : 0);
    reorderedFields.splice(insertIndex, 0, sourceField);

    const hasChanged = reorderedFields.some(
      (field, index) => field !== availableFields[index]
    );

    if (!hasChanged) return;

    setAvailableFields(reorderedFields);

    setSelectedFields((previous) => {
      const selected = new Set(previous);
      return reorderedFields.filter((field) => selected.has(field));
    });
  };

  const handleFieldPointerUp = () => {
    setActiveDrag(null);
  };

  const filteredFields = availableFields.filter(f => f.toLowerCase().includes(fieldSearchTerm.toLowerCase()));

  return (
    <div className="min-h-screen lg:h-dvh lg:min-h-0 lg:overflow-hidden bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 flex flex-col font-sans selection:bg-[#ff6be4] selection:text-white">
      
      {/* Custom Scrollbar Styles */}
      <style jsx global>{`
        ::-webkit-scrollbar {
          width: 6px;
          height: 6px;
        }
        ::-webkit-scrollbar-track {
          background: transparent;
        }
        ::-webkit-scrollbar-thumb {
          background: linear-gradient(
            to bottom,
            rgba(255, 107, 228, 0.5),
            rgba(244, 63, 94, 0.5)
          );
          border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
          background: linear-gradient(
            to bottom,
            rgba(224, 76, 200, 0.65),
            rgba(225, 29, 72, 0.65)
          );
        }
      `}</style>

      {/* Top Header */}
      <header className="shrink-0 sticky top-0 z-30 border-b border-slate-200 dark:border-slate-800/80 bg-white/80 dark:bg-slate-950/80 backdrop-blur-md">
        <div className="max-w-[1700px] mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl overflow-hidden shadow-lg shadow-[#ff6be4]/30 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" className="w-full h-full">
                <rect fill="#ff6be4" x="-.26" y="-.73" width="120" height="120" rx="30.16" ry="30.16"/>
                <g fill="#ffffff">
                  <polygon points="49.26 75.82 34.04 84.6 34.04 74.38 20.83 92.11 34.49 100 51.33 90.28 62.29 36.46 49.26 53.95 49.26 75.82"/>
                  <polygon points="89.16 78.03 89.16 85.41 77.67 78.81 77.67 62.68 67.96 49.72 67.96 84.38 98.26 90.18 95.21 86.11 89.16 78.03"/>
                  <polygon points="89.16 47.55 89.16 76.53 95.99 85.66 98.5 89.01 88.39 36.74 68.17 48.51 77.67 61.18 77.67 54.24 89.16 47.55"/>
                  <polygon points="98.04 91.05 70.05 85.69 88.71 96.41 98.04 91.05"/>
                  <polygon points="98.86 86.17 98.86 42.39 96.37 40.96 89.34 36.91 98.86 86.17"/>
                  <polygon points="20.61 87.56 33.86 18.71 20.61 26.36 20.61 87.56"/>
                  <polygon points="34.04 72.88 34.04 33.74 49.26 42.64 49.26 52.46 55.17 44.52 62.47 34.72 34.81 18.54 20.97 90.42 34.04 72.88"/>
                  <polygon points="62.68 39.03 52.38 89.62 62.68 83.64 62.68 39.03"/>
                </g>
              </svg>
            </div>
            <div>
              <h1 className="font-bold text-lg tracking-tight bg-gradient-to-r from-[#ff6be4] to-pink-500 bg-clip-text text-transparent">
                NPC-DateConverter
              </h1>
              <p className="text-[10px] text-slate-400 font-mono -mt-1">Universal Multi-Format Engine</p>
            </div>
          </div>

          <div className="flex items-center gap-3">
            <div className="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-600 border border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-400 dark:border-emerald-800/50">
              <ShieldCheck className="w-3.5 h-3.5" />
              <span>100% Client Privacy</span>
            </div>
            <button
              onClick={() => setTheme(theme === 'dark' ? 'light' : 'dark')}
