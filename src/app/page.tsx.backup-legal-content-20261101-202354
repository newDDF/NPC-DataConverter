const renderDataTable = (
  rows: Record<string, any>[],
  emptyMessage: string
) => {
  if (rows.length === 0) {
    return (
      <div className="flex flex-1 items-center justify-center rounded-xl border border-dashed border-slate-300 dark:border-slate-700 p-6 text-center text-xs text-slate-500 dark:text-slate-400">
        {emptyMessage}
      </div>
    );
  }

  const columns = Array.from(
    new Set(rows.flatMap((row) => Object.keys(row)))
  );

  if (columns.length === 0) {
    return (
      <div className="flex flex-1 items-center justify-center text-xs text-slate-500">
        No tabular fields found.
      </div>
    );
  }

  const formatCell = (value: unknown): string => {
    if (value === null || value === undefined) return '';
    if (typeof value === 'object') {
      return JSON.stringify(value) ?? String(value);
    }
    return String(value);
  };

  return (
    <div className="flex-1 min-h-0 overflow-auto rounded-xl border border-slate-200 dark:border-slate-800">
      <table className="min-w-full border-collapse text-left text-xs">
        <thead className="sticky top-0 z-10 bg-slate-100 dark:bg-slate-800">
          <tr>
            {columns.map((column) => (
              <th
                key={column}
                className="whitespace-nowrap border-b border-slate-200 dark:border-slate-700 px-3 py-2 font-semibold text-slate-700 dark:text-slate-200"
              >
                {column}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row, rowIndex) => (
            <tr
              key={rowIndex}
              className="border-b border-slate-100 dark:border-slate-800 last:border-0 hover:bg-slate-50 dark:hover:bg-slate-800/60"
            >
              {columns.map((column) => (
                <td
                  key={column}
                  className="max-w-xs whitespace-pre-wrap break-words px-3 py-2 align-top text-slate-600 dark:text-slate-300"
                >
                  {formatCell(row[column])}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
      <div className="border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 px-3 py-2 text-[11px] text-slate-500 dark:text-slate-400">
        {rows.length} record(s) · {columns.length} field(s)
      </div>
    </div>
  );
};

export default function App() {
  const [theme, setTheme] = useState<'dark' | 'light'>('dark');
  const [inputFormat, setInputFormat] = useState<InputFormatOption>('auto');
  const [detectedFormat, setDetectedFormat] = useState<DataFormat>('json');
  const [outputFormat, setOutputFormat] = useState<DataFormat>('json');
  const [inputData, setInputData] = useState(SAMPLES.users.data);
  const [outputData, setOutputData] = useState('');
  const [outputBlob, setOutputBlob] = useState<Blob | null>(null);
  const [recordCount, setRecordCount] = useState(0);
  const [convertedRows, setConvertedRows] = useState<Record<string, any>[]>([]);
  const [isCopied, setIsCopied] = useState(false);

  const [availableFields, setAvailableFields] = useState<string[]>([]);
  const [selectedFields, setSelectedFields] = useState<string[]>([]);
  const [fieldSearchTerm, setFieldSearchTerm] = useState('');
  const [activeModal, setActiveModal] = useState<'privacy' | 'terms' | null>(null);

  const [inputViewMode, setInputViewMode] = useState<'code' | 'table'>('code');
  const [outputViewMode, setOutputViewMode] = useState<'code' | 'table'>('code');
  const [activeDrag, setActiveDrag] = useState<{
    field: string;
    x: number;
    y: number;
  } | null>(null);

  useEffect(() => {
    if (theme === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  }, [theme]);


  const activeInputFormat = inputFormat === 'auto' ? detectedFormat : inputFormat;

  useEffect(() => {
    if (inputFormat === 'auto') {
      setDetectedFormat(detectFormat(inputData));
    }
  }, [inputData, inputFormat]);

  const parseRawToJS = useCallback(
    (raw: string, fmt: DataFormat): Record<string, any>[] => {
      return parseTextData(raw, fmt);
    },
    []
  );

  const inputPreviewRows = useMemo(() => {
    try {
      return parseRawToJS(inputData, activeInputFormat);
    } catch {
      return [];
    }
  }, [inputData, activeInputFormat, parseRawToJS]);

  useEffect(() => {
    try {
      const rows = parseRawToJS(inputData, activeInputFormat);
      if (rows && rows.length > 0) {
        const keysSet = new Set<string>();
        rows.forEach((row) => {
          if (typeof row === 'object' && row !== null) {
            Object.keys(row).forEach((k) => keysSet.add(k));
          }
        });
        const fields = Array.from(keysSet);
        setAvailableFields(fields);
        setSelectedFields((prev) => {
          if (prev.length === 0 || !prev.every(f => fields.includes(f))) {
            return fields;
          }
          return prev;
        });
      }
    } catch {
      setAvailableFields([]);
      setSelectedFields([]);
    }
  }, [inputData, activeInputFormat, parseRawToJS]);

  const handleConvert = () => {
    try {
      const rows = parseRawToJS(inputData, activeInputFormat);
      setRecordCount(rows.length);

      const fields = selectedFields.length > 0
        ? selectedFields
        : availableFields.length > 0
          ? availableFields
          : Object.keys(rows[0] ?? {});

      const filtered = rows.map((row) => {
        const result: Record<string, any> = {};
        fields.forEach((field) => {
          if (Object.prototype.hasOwnProperty.call(row, field)) {
            result[field] = row[field];
          }
        });
        return result;
      });

      setConvertedRows(filtered);

      if (outputFormat === 'excel') {
        setOutputBlob(createExcelBlob(filtered));
        setOutputData(
          `Excel workbook ready. ${filtered.length} record(s) will be exported to an .xlsx file.`
        );
      } else {
        setOutputBlob(null);
        setOutputData(serializeRows(filtered, outputFormat, fields));
      }
    } catch (error) {
      setOutputBlob(null);
      setRecordCount(0);
      setConvertedRows([]);
      const message = error instanceof Error ? error.message : 'Unknown conversion error';
      setOutputData(`Conversion error: ${message}`);
    }
  };

  useEffect(() => {
    handleConvert();
  }, [inputData, activeInputFormat, outputFormat, selectedFields, availableFields, parseRawToJS]);

  const handleCopy = async () => {
    if (!outputData || outputFormat === 'excel') return;

    try {
      await navigator.clipboard.writeText(outputData);
      setIsCopied(true);
      window.setTimeout(() => setIsCopied(false), 2000);
    } catch {
      setIsCopied(false);
    }
  };

  const handleDownload = () => {
    if (!outputData) return;

    const isExcel = outputFormat === 'excel';
    const blob = isExcel && outputBlob
      ? outputBlob
      : new Blob([outputData], { type: 'text/plain;charset=utf-8' });

    const extension = isExcel ? 'xlsx' : outputFormat;
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement('a');

    anchor.href = url;
    anchor.download = `converted_data.${extension}`;
    document.body.appendChild(anchor);
    anchor.click();
    anchor.remove();

    window.setTimeout(() => URL.revokeObjectURL(url), 1000);
  };

  const handleFieldPointerDown = (
    e: React.PointerEvent<HTMLSpanElement>,
    field: string
  ) => {
    e.preventDefault();
    e.stopPropagation();

    e.currentTarget.setPointerCapture(e.pointerId);

    setActiveDrag({
      field,
      x: e.clientX,
      y: e.clientY,
    });
  };

  const handleFieldPointerMove = (e: React.PointerEvent<HTMLDivElement>) => {
    if (!activeDrag) return;

    setActiveDrag((current) =>
      current
        ? { ...current, x: e.clientX, y: e.clientY }
        : null
    );

    const element = document.elementFromPoint(e.clientX, e.clientY);
    const targetRow = element?.closest<HTMLElement>('[data-field-key]');
    const targetField = targetRow?.dataset.fieldKey;
    const sourceField = activeDrag.field;

    if (!targetField || targetField === sourceField || !targetRow) return;

    const rect = targetRow.getBoundingClientRect();
    const insertAfter = e.clientY > rect.top + rect.height / 2;

    const reorderedFields = [...availableFields];
    const fromIndex = reorderedFields.indexOf(sourceField);

    if (fromIndex < 0) return;

    reorderedFields.splice(fromIndex, 1);

    const targetIndex = reorderedFields.indexOf(targetField);
    if (targetIndex < 0) return;

    const insertIndex = targetIndex + (insertAfter ? 1 : 0);
    reorderedFields.splice(insertIndex, 0, sourceField);

    const hasChanged = reorderedFields.some(
      (field, index) => field !== availableFields[index]
    );

    if (!hasChanged) return;

    setAvailableFields(reorderedFields);

    setSelectedFields((previous) => {
      const selected = new Set(previous);
      return reorderedFields.filter((field) => selected.has(field));
    });
  };

  const handleFieldPointerUp = () => {
    setActiveDrag(null);
  };

  const filteredFields = availableFields.filter(f => f.toLowerCase().includes(fieldSearchTerm.toLowerCase()));

  return (
    <div className="min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 flex flex-col font-sans selection:bg-[#ff6be4] selection:text-white">
      
      {/* Custom Scrollbar Styles */}
      <style jsx global>{`
        ::-webkit-scrollbar {
          width: 6px;
          height: 6px;
        }
        ::-webkit-scrollbar-track {
          background: transparent;
        }
        ::-webkit-scrollbar-thumb {
          background: linear-gradient(to bottom, #ff6be4, #f43f5e);
          border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
          background: linear-gradient(to bottom, #e04cc8, #e11d48);
        }
      `}</style>

      {/* Top Header */}
      <header className="sticky top-0 z-30 border-b border-slate-200 dark:border-slate-800/80 bg-white/80 dark:bg-slate-950/80 backdrop-blur-md">
        <div className="max-w-[1700px] mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl overflow-hidden shadow-lg shadow-[#ff6be4]/30 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" className="w-full h-full">
                <rect fill="#ff6be4" x="-.26" y="-.73" width="120" height="120" rx="30.16" ry="30.16"/>
                <g fill="#ffffff">
                  <polygon points="49.26 75.82 34.04 84.6 34.04 74.38 20.83 92.11 34.49 100 51.33 90.28 62.29 36.46 49.26 53.95 49.26 75.82"/>
                  <polygon points="89.16 78.03 89.16 85.41 77.67 78.81 77.67 62.68 67.96 49.72 67.96 84.38 98.26 90.18 95.21 86.11 89.16 78.03"/>
                  <polygon points="89.16 47.55 89.16 76.53 95.99 85.66 98.5 89.01 88.39 36.74 68.17 48.51 77.67 61.18 77.67 54.24 89.16 47.55"/>
                  <polygon points="98.04 91.05 70.05 85.69 88.71 96.41 98.04 91.05"/>
                  <polygon points="98.86 86.17 98.86 42.39 96.37 40.96 89.34 36.91 98.86 86.17"/>
                  <polygon points="20.61 87.56 33.86 18.71 20.61 26.36 20.61 87.56"/>
                  <polygon points="34.04 72.88 34.04 33.74 49.26 42.64 49.26 52.46 55.17 44.52 62.47 34.72 34.81 18.54 20.97 90.42 34.04 72.88"/>
                  <polygon points="62.68 39.03 52.38 89.62 62.68 83.64 62.68 39.03"/>
                </g>
              </svg>
            </div>
            <div>
              <h1 className="font-bold text-lg tracking-tight bg-gradient-to-r from-[#ff6be4] to-pink-500 bg-clip-text text-transparent">
                NPC-DateConverter
              </h1>
              <p className="text-[10px] text-slate-400 font-mono -mt-1">Universal Multi-Format Engine</p>
            </div>
          </div>

          <div className="flex items-center gap-3">
            <div className="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-600 border border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-400 dark:border-emerald-800/50">
              <ShieldCheck className="w-3.5 h-3.5" />
              <span>100% Client Privacy</span>
            </div>
            <button
              onClick={() => setTheme(theme === 'dark' ? 'light' : 'dark')}
              className="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:text-[#ff6be4] transition-colors"
            >
              {theme === 'dark' ? <Sun className="w-4 h-4" /> : <Moon className="w-4 h-4" />}
            </button>
          </div>
        </div>
      </header>

      {/* Main Layout 3:9 ratio */}
      <main className="flex-1 max-w-[1700px] w-full mx-auto p-4 sm:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        {/* Left Sidebar (3 Cols) */}
        <aside className="lg:col-span-3 space-y-5 flex flex-col">
          
          {/* Format Pipeline Unified Card */}
          <div className="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 shadow-sm space-y-4">
            <div>
              <span className="text-xs font-bold uppercase tracking-wider text-slate-400 block mb-2">Source Format</span>
              <div className="grid grid-cols-3 gap-1.5">
                {(['auto', 'json', 'csv', 'excel', 'xml', 'yaml', 'md'] as InputFormatOption[]).map((fmt) => (
                  <button
                    key={fmt}
                    onClick={() => setInputFormat(fmt)}
                    className={`py-1.5 px-1 rounded-xl text-xs font-semibold transition-all capitalize text-center truncate border ${
                      inputFormat === fmt
                        ? 'bg-gradient-to-r from-[#ff6be4] to-rose-500 text-white shadow-md shadow-pink-500/25 border-pink-400'
                        : 'bg-slate-50 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-pink-400'
                    }`}
                  >
                    {fmt}
                  </button>
                ))}
              </div>
            </div>

            <div className="flex justify-center my-2">
              <button
                onClick={handleConvert}
                className="w-full py-2 bg-gradient-to-r from-[#ff6be4] to-rose-500 hover:opacity-90 text-white rounded-xl text-xs font-bold shadow-md shadow-pink-500/25 flex items-center justify-center gap-2 transition-all"
              >
                <ArrowRightLeft className="w-4 h-4 animate-spin-slow" />
                <span>Convert Data</span>
              </button>
            </div>

            <div>
              <span className="text-xs font-bold uppercase tracking-wider text-slate-400 block mb-2">Target Format</span>
              <div className="grid grid-cols-3 gap-1.5">
                {(['json', 'csv', 'excel', 'xml', 'yaml', 'md'] as DataFormat[]).map((fmt) => (
                  <button
                    key={fmt}
                    onClick={() => setOutputFormat(fmt)}
                    className={`py-1.5 px-1 rounded-xl text-xs font-semibold transition-all capitalize text-center truncate border ${
                      outputFormat === fmt
                        ? 'bg-gradient-to-r from-[#ff6be4] to-rose-500 text-white shadow-md shadow-pink-500/25 border-pink-400'
                        : 'bg-slate-50 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-pink-400'
                    }`}
                  >
                    {fmt}
                  </button>
                ))}
              </div>
            </div>
          </div>

          {/* Fields Selection & Drag Reorder Card */}
          <div className="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 shadow-sm space-y-3 flex-1 flex flex-col">
            <div className="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800">
              <div className="flex items-center space-x-1.5">
                <ListFilter className="w-4 h-4 text-[#ff6be4]" />
                <span className="font-bold text-xs text-slate-800 dark:text-slate-200 uppercase tracking-wide">Fields (Drag to Reorder)</span>
              </div>
              <span className="text-[10px] bg-pink-500/10 text-[#ff6be4] font-medium px-2 py-0.5 rounded-full">
                {selectedFields.length}/{availableFields.length}
              </span>
            </div>

            <div className="relative">
              <Search className="w-3.5 h-3.5 absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400" />
              <input
                type="text"
                value={fieldSearchTerm}
                onChange={(e) => setFieldSearchTerm(e.target.value)}
                placeholder="Search fields..."
                className="w-full pl-8 pr-3 py-1 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-xs focus:outline-none focus:ring-1 focus:ring-[#ff6be4]"
              />
            </div>

            <div className="flex items-center justify-between gap-1">
              <button
                onClick={() => setSelectedFields(availableFields)}
                className="flex-1 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-pink-50 dark:hover:bg-pink-950 text-[10px] font-medium text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700"
              >
                Select All
              </button>
              <button
                onClick={() => setSelectedFields([])}
                className="flex-1 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-rose-50 dark:hover:bg-rose-950 text-[10px] font-medium text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700"
              >
                Deselect All
              </button>
            </div>

            <div
              className="relative flex flex-col gap-1.5 max-h-64 overflow-y-auto p-0.5"
              onPointerMove={handleFieldPointerMove}
              onPointerUp={handleFieldPointerUp}
              onPointerCancel={() => setActiveDrag(null)}
            >
              {filteredFields.map((field) => {
                const isSelected = selectedFields.includes(field);
                return (
                  <div
                    key={field}
                    data-field-key={field}
                    onClick={() => {
                      setSelectedFields(prev =>
                        isSelected ? prev.filter(f => f !== field) : [...prev, field]
                      );
                    }}
                    className={`px-2.5 py-2 rounded-xl text-xs font-medium flex items-center justify-between transition-all border cursor-default ${
                      activeDrag?.field === field
                        ? 'opacity-30 border-dashed border-[#ff6be4]'
                        : isSelected
                          ? 'bg-pink-50/80 dark:bg-pink-950/40 text-[#ff6be4] border-pink-400 shadow-sm'
                          : 'bg-slate-50 dark:bg-slate-800/80 text-slate-500 border-slate-200 dark:border-slate-700'
                    }`}
                  >
                    <div className="flex items-center gap-2 overflow-hidden">
                      <span
                        onPointerDown={(e) => handleFieldPointerDown(e, field)}
                        onClick={(e) => e.stopPropagation()}
                        title="Drag to reorder field"
                        style={{ touchAction: 'none' }}
                        className="text-slate-400 font-mono cursor-grab active:cursor-grabbing select-none"
                      >
                        ⠿
                      </span>
                      <span className="truncate text-[11px] font-mono">{field}</span>
                    </div>
                    {isSelected && <Check className="w-3.5 h-3.5 text-[#ff6be4]" />}
                  </div>
                );
              })}

              {activeDrag && (
                <div
                  aria-hidden="true"
                  className="pointer-events-none fixed z-[9999] flex items-center gap-2 rounded-xl border border-[#ff6be4] bg-white/95 dark:bg-slate-900/95 px-3 py-2 text-xs font-medium text-[#ff6be4] shadow-2xl scale-[1.03]"
                  style={{
                    left: activeDrag.x,
                    top: activeDrag.y,
                    transform: 'translate(-50%, -50%)',
                    minWidth: '150px',
                  }}
                >
                  <span className="font-mono text-slate-400">⠿</span>
                  <span className="truncate">{activeDrag.field}</span>
                </div>
              )}
            </div>
          </div>
        </aside>

        {/* Right Main Content (9 Cols) */}
        <section className="lg:col-span-9 flex flex-col space-y-6">
          
          {/* Quick Samples & Actions */}
          <div className="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-4 shadow-sm flex flex-wrap items-center justify-between gap-4">
            <div className="flex flex-wrap items-center gap-2">
              <span className="text-xs font-semibold uppercase tracking-wider text-slate-400 mr-2 flex items-center">
                <Layers className="w-3.5 h-3.5 mr-1.5 text-[#ff6be4]" /> Quick Samples:
              </span>
              {Object.keys(SAMPLES).map((key) => (
                <button
                  key={key}
                  onClick={() => {
                    setInputData(SAMPLES[key].data);
                    setInputFormat(SAMPLES[key].format);
                  }}
                  className="px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-pink-50 dark:hover:bg-pink-950 hover:text-[#ff6be4] text-xs font-medium transition-all border border-slate-200 dark:border-slate-700"
                >
                  {SAMPLES[key].name} ({SAMPLES[key].format.toUpperCase()})
                </button>
              ))}
            </div>
            <button
              onClick={() => {
                setInputData('');
                setOutputData('');
                setAvailableFields([]);
                setSelectedFields([]);
              }}
              className="px-3 py-1.5 text-xs font-medium text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/50 rounded-lg transition-all border border-rose-200 dark:border-rose-900 flex items-center"
            >
              <Trash2 className="w-3.5 h-3.5 mr-1.5" /> Clear Workspace
            </button>
          </div>

          {/* Dual Editor Grid */}
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
            
            {/* Input Data Editor */}
            <div className="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col overflow-hidden h-[620px]">
              <div className="p-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between bg-slate-50/50 dark:bg-slate-800/50">
                <div className="flex items-center space-x-2">
                  <FileCode className="w-4 h-4 text-[#ff6be4]" />
                  <span className="font-semibold text-sm text-slate-800 dark:text-slate-200">Input Data</span>
                </div>
                <div className="flex items-center bg-slate-200 dark:bg-slate-800 p-0.5 rounded-xl">
                  <button
                    onClick={() => setInputViewMode('code')}
                    className={`p-1.5 rounded-lg text-xs font-medium ${inputViewMode === 'code' ? 'bg-white dark:bg-slate-700 text-[#ff6be4] shadow-sm' : 'text-slate-500'}`}
                  >
                    <Code2 className="w-3.5 h-3.5" />
                  </button>
                  <button
                    onClick={() => setInputViewMode('table')}
                    className={`p-1.5 rounded-lg text-xs font-medium ${inputViewMode === 'table' ? 'bg-white dark:bg-slate-700 text-[#ff6be4] shadow-sm' : 'text-slate-500'}`}
                  >
                    <Table className="w-3.5 h-3.5" />
                  </button>
                </div>
              </div>

              <div className="border-b border-dashed border-slate-200 dark:border-slate-800 p-3 text-center bg-slate-50/30 dark:bg-slate-900/30">
                <div className="flex items-center justify-center space-x-2 text-xs text-slate-500 dark:text-slate-400">
                  <Upload className="w-3.5 h-3.5 text-[#ff6be4]" />
                  <span>Drag & drop file here or</span>
                  <label className="text-[#ff6be4] font-semibold cursor-pointer hover:underline">
                    browse file
                    <input
                      type="file"
                      accept=".json,.csv,.xml,.yaml,.yml,.md,.xlsx,.xls"
                      onChange={async (e) => {
                        const file = e.target.files?.[0];
                        if (!file) return;

                        try {
                          const extension = file.name.split('.').pop()?.toLowerCase() ?? '';

                          if (extension === 'xlsx' || extension === 'xls') {
                            const buffer = await file.arrayBuffer();
                            const rows = parseExcelBuffer(buffer);
                            setInputData(JSON.stringify(rows, null, 2));
                            setInputFormat('json');
                          } else {
                            const text = await file.text();
                            const formats: Record<string, DataFormat> = {
                              json: 'json',
                              csv: 'csv',
                              xml: 'xml',
                              yaml: 'yaml',
                              yml: 'yaml',
                              md: 'md',
                            };

                            setInputData(text);
                            setInputFormat(formats[extension] ?? 'auto');
                          }
                        } catch (error) {
                          const message = error instanceof Error ? error.message : 'Unable to read file';
                          setOutputData(`File import error: ${message}`);
                        } finally {
                          e.target.value = '';
                        }
                      }}
                      className="hidden"
                    />
                  </label>
                </div>
              </div>

              <div className="p-4 flex-1 flex flex-col">
                {inputViewMode === 'code' ? (
                  <textarea
                    value={inputData}
                    onChange={(e) => setInputData(e.target.value)}
                    placeholder="Paste or type your source data here..."
                    className="w-full flex-1 font-mono text-xs p-3 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#ff6be4] resize-none"
                  />
                ) : (
                  renderDataTable(
                    inputPreviewRows,
                    'No input records available. Check the source data and selected format.'
                  )
                )}
              </div>
            </div>

            {/* Converted Output Editor */}
            <div className="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col overflow-hidden h-[620px]">
              <div className="p-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between bg-slate-50/50 dark:bg-slate-800/50">
                <div className="flex items-center space-x-2">
                  <FileText className="w-4 h-4 text-[#ff6be4]" />
                  <span className="font-semibold text-sm text-slate-800 dark:text-slate-200">Converted Output</span>
                </div>
                <div className="flex items-center bg-slate-200 dark:bg-slate-800 p-0.5 rounded-xl">
                  <button
                    onClick={() => setOutputViewMode('code')}
                    className={`p-1.5 rounded-lg text-xs font-medium ${outputViewMode === 'code' ? 'bg-white dark:bg-slate-700 text-[#ff6be4] shadow-sm' : 'text-slate-500'}`}
                  >
                    <Code2 className="w-3.5 h-3.5" />
                  </button>
                  <button
                    onClick={() => setOutputViewMode('table')}
                    className={`p-1.5 rounded-lg text-xs font-medium ${outputViewMode === 'table' ? 'bg-white dark:bg-slate-700 text-[#ff6be4] shadow-sm' : 'text-slate-500'}`}
                  >
                    <Table className="w-3.5 h-3.5" />
                  </button>
                </div>
              </div>

              <div className="p-4 flex-1 flex flex-col">
                {outputViewMode === 'code' ? (
                  <textarea
                    readOnly
                    value={outputData}
                    placeholder="Converted output will appear here in real-time..."
                    className="w-full flex-1 font-mono text-xs p-3 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl focus:outline-none resize-none"
                  />
                ) : (
                  renderDataTable(
                    convertedRows,
                    outputData.startsWith('Conversion error:')
                      ? outputData
                      : 'No converted records available yet.'
                  )
                )}
              </div>

              <div className="p-4 border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/30 flex items-center justify-between flex-wrap gap-3">
                <div className="text-xs text-slate-500 dark:text-slate-400">
                  Records: <span className="font-semibold text-slate-700 dark:text-slate-300">{recordCount}</span> · Fields: <span className="font-semibold text-slate-700 dark:text-slate-300">{selectedFields.length}</span>
                </div>

                <div className="flex items-center space-x-2">
                  <button
                    onClick={handleCopy}
                    disabled={!outputData || outputFormat === 'excel'}
                    className="px-4 py-2 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-semibold rounded-xl transition-all flex items-center"
                  >
                    {isCopied ? <Check className="w-3.5 h-3.5 mr-1.5 text-emerald-500" /> : <Copy className="w-3.5 h-3.5 mr-1.5" />}
                    {isCopied ? 'Copied' : 'Copy'}
                  </button>
                  <button
                    onClick={handleDownload}
                    disabled={!outputData || (outputFormat === 'excel' && !outputBlob)}
                    className="px-4 py-2 bg-gradient-to-r from-[#ff6be4] to-rose-500 hover:opacity-90 text-white text-xs font-semibold rounded-xl shadow-md shadow-pink-500/25 transition-all flex items-center"
                  >
                    <Download className="w-3.5 h-3.5 mr-1.5" /> Download File
                  </button>
                </div>
              </div>
            </div>

          </div>

        </section>

      </main>

      {/* Footer */}
      <footer className="border-t border-slate-200 dark:border-slate-800/80 bg-white/50 dark:bg-slate-950/50 py-4 px-6 mt-auto">
        <div className="max-w-[1700px] mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
          <div>NPC-DateConverter &copy; 2026. All rights reserved.</div>
          <div className="flex items-center space-x-6">
            <button
              onClick={() => setActiveModal('privacy')}
              className="hover:text-[#ff6be4] transition-colors flex items-center gap-1.5"
            >
              <ShieldCheck className="w-3.5 h-3.5 text-[#ff6be4]" />
              <span>Privacy Policy</span>
            </button>
            <span>•</span>
            <button
              onClick={() => setActiveModal('terms')}
              className="hover:text-[#ff6be4] transition-colors flex items-center gap-1.5"
            >
              <Lock className="w-3.5 h-3.5 text-[#ff6be4]" />
              <span>Terms of Service</span>
            </button>
            <span>•</span>
            <a
              href="https://GitHub.com/newddf/"
              target="_blank"
              rel="noopener noreferrer"
              className="hover:text-[#ff6be4] transition-colors flex items-center space-x-1.5"
            >
              <svg className="w-3.5 h-3.5 text-[#ff6be4]" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
              <span>Developer Source</span>
            </a>
          </div>
        </div>
      </footer>

      {/* Glassmorphic Modal Dialogs */}
      {activeModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/40 backdrop-blur-md">
          <div className="bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl border border-slate-200 dark:border-slate-800 rounded-3xl max-w-xl w-full p-8 shadow-2xl relative space-y-4">
            <button
              onClick={() => setActiveModal(null)}
              className="absolute right-6 top-6 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"
            >
              <X className="w-5 h-5" />
            </button>

            {activeModal === 'privacy' ? (
              <div className="space-y-3">
                <div className="flex items-center gap-2 text-slate-900 dark:text-white font-bold text-lg">
                  <ShieldCheck className="w-5 h-5 text-[#ff6be4]" />
                  <h2>Privacy Policy</h2>
                </div>
                <p className="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                  Effective Date: October 2026<br /><br />
                  NPC-DateConverter is deeply committed to safeguarding your personal data. All transformation and parsing operations execute entirely within your browser's local sandbox environment. Your files are never uploaded or stored on remote servers.
                </p>
              </div>
            ) : (
              <div className="space-y-3">
                <div className="flex items-center gap-2 text-slate-900 dark:text-white font-bold text-lg">
                  <Lock className="w-5 h-5 text-[#ff6be4]" />
                  <h2>Terms of Service</h2>
                </div>
                <p className="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                  Effective Date: October 2026<br /><br />
                  NPC-DateConverter is provided free of charge as an open utility tool. By using this platform, you agree to use it responsibly. Maintained via <a href="https://GitHub.com/newddf/" target="_blank" className="text-[#ff6be4] underline">GitHub.com/newddf/</a>.
                </p>
              </div>
            )}

            <button
              onClick={() => setActiveModal(null)}
              className="w-full py-2.5 bg-gradient-to-r from-[#ff6be4] to-rose-500 hover:opacity-90 text-white rounded-xl text-xs font-semibold shadow-md shadow-pink-500/25"
            >
              Acknowledge & Close
            </button>
          </div>
        </div>
      )}

    </div>
  );
}
