'use client';

import { useMemo, useRef, useState } from 'react';
import {
  FilePlus2,
  FileText,
  X,
  Download,
  Play,
  Trash2,
  AlertCircle,
  CheckCircle2,
  Clock3,
  LoaderCircle,
} from 'lucide-react';
import type { DataFormat } from '@/types/converter';
import type { BatchTask } from '@/types/batch';
import {
  convertBatchRows,
  getBatchOutputExtension,
  getBatchSourceFormat,
  readBatchSource,
} from '@/lib/batch/convert';

const TARGET_FORMATS: DataFormat[] = [
  'json',
  'csv',
  'excel',
  'xml',
  'yaml',
  'md',
];

const createTaskId = () =>
  `${Date.now()}-${Math.random().toString(36).slice(2, 9)}`;

const formatSize = (bytes: number) => {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
};

const statusLabel: Record<BatchTask['status'], string> = {
  waiting: 'Waiting',
  processing: 'Processing',
  completed: 'Completed',
  failed: 'Failed',
};

interface BatchWorkspaceProps {
  isOpen: boolean;
  onClose: () => void;
}

export default function BatchWorkspace({ isOpen, onClose }: BatchWorkspaceProps) {
  const [tasks, setTasks] = useState<BatchTask[]>([]);
  const [activeTaskId, setActiveTaskId] = useState<string | null>(null);
  const [targetFormat, setTargetFormat] = useState<DataFormat>('json');
  const [isDragging, setIsDragging] = useState(false);
  const [isRunning, setIsRunning] = useState(false);
  const isRunningRef = useRef(false);
  const fileInputRef = useRef<HTMLInputElement>(null);

  const activeTask = tasks.find((task) => task.id === activeTaskId) ?? null;

  if (!isOpen) return null;

  const completedCount = useMemo(
    () => tasks.filter((task) => task.status === 'completed').length,
    [tasks]
  );

  const addFiles = (files: FileList | File[]) => {
    const incoming = Array.from(files);
    const newTasks: BatchTask[] = incoming.map((file) => {
      const sourceFormat = getBatchSourceFormat(file.name);

      return {
        id: createTaskId(),
        file,
        name: file.name,
        size: file.size,
        sourceFormat,
        outputFormat: null,
        status: sourceFormat ? 'waiting' : 'failed',
        sourcePreview: '',
        outputText: '',
        outputBlob: null,
        error: sourceFormat ? '' : 'Unsupported file type.',
        recordCount: 0,
      };
    });

    setTasks((current) => [...current, ...newTasks]);

    if (!activeTaskId && newTasks.length > 0) {
      setActiveTaskId(newTasks[0].id);
    }
  };

  const updateTask = (id: string, updates: Partial<BatchTask>) => {
    setTasks((current) =>
      current.map((task) => task.id === id ? { ...task, ...updates } : task)
    );
  };

  const processTask = async (task: BatchTask, format: DataFormat) => {
    if (
      !task.sourceFormat ||
      task.status === 'processing' ||
      task.status === 'completed'
    ) return;

    updateTask(task.id, {
      status: 'processing',
      outputFormat: null,
      error: '',
      outputText: '',
      outputBlob: null,
    });

    try {
      const source = await readBatchSource(task.file, task.sourceFormat);
      const result = convertBatchRows(source.rows, format);

      updateTask(task.id, {
        status: 'completed',
        outputFormat: format,
        sourcePreview: source.preview,
        outputText: result.text,
        outputBlob: result.blob,
        recordCount: source.rows.length,
      });
    } catch (error) {
      updateTask(task.id, {
        status: 'failed',
        error: error instanceof Error ? error.message : 'Conversion failed.',
      });
    }
  };

  const startAll = async () => {
    if (isRunningRef.current) return;

    const pending = tasks.filter(
      (task) =>
        task.sourceFormat !== null &&
        (task.status === 'waiting' || task.status === 'failed')
    );

    if (pending.length === 0) return;

    isRunningRef.current = true;
    setIsRunning(true);

    const formatForRun = targetFormat;

    try {
      for (const task of pending) {
        await processTask(task, formatForRun);
      }
    } finally {
      isRunningRef.current = false;
      setIsRunning(false);
    }
  };

  const downloadTask = (task: BatchTask) => {
    if (task.status !== 'completed') return;

    const blob = task.outputBlob ?? new Blob(
      [task.outputText],
      { type: 'text/plain;charset=utf-8' }
    );

    const url = URL.createObjectURL(blob);
    const anchor = document.createElement('a');
    const baseName = task.name.replace(/\.[^.]+$/, '');

    anchor.href = url;
    const outputFormat = task.outputFormat;
    if (!outputFormat) return;

    anchor.download = `${baseName}.${getBatchOutputExtension(outputFormat)}`;
    document.body.appendChild(anchor);
    anchor.click();
    anchor.remove();
    window.setTimeout(() => URL.revokeObjectURL(url), 1000);
  };

  const removeTask = (id: string) => {
    setTasks((current) => current.filter((task) => task.id !== id));
    if (activeTaskId === id) {
      const next = tasks.find((task) => task.id !== id);
      setActiveTaskId(next?.id ?? null);
    }
  };

  const clearCompleted = () => {
    setTasks((current) => current.filter((task) => task.status !== 'completed'));
    if (activeTask?.status === 'completed') setActiveTaskId(null);
  };

  const statusIcon = (status: BatchTask['status']) => {
    if (status === 'completed') return <CheckCircle2 className="h-4 w-4 text-emerald-500" />;
    if (status === 'failed') return <AlertCircle className="h-4 w-4 text-rose-500" />;
    if (status === 'processing') return <LoaderCircle className="h-4 w-4 animate-spin text-[#ff6be4]" />;
    return <Clock3 className="h-4 w-4 text-slate-400" />;
  };

  return (
    <div className="fixed inset-0 z-50">
      <button
        type="button"
        aria-label="Close batch processing"
        onClick={onClose}
        className="absolute inset-0 h-full w-full bg-slate-950/40 backdrop-blur-[2px]"
      />
      <aside className="absolute inset-y-0 right-0 flex w-full max-w-xl flex-col gap-4 overflow-hidden border-l border-slate-200 bg-slate-50 p-4 shadow-2xl dark:border-slate-800 dark:bg-slate-950 sm:p-6">
        <div className="flex shrink-0 items-center justify-between">
          <div>
            <h2 className="text-base font-bold text-slate-800 dark:text-slate-100">Batch Processing</h2>
            <p className="mt-1 text-xs text-slate-500 dark:text-slate-400">
              Manage and convert multiple files locally.
            </p>
          </div>
          <button
            type="button"
            onClick={onClose}
            aria-label="Close batch processing"
            title="Close"
            className="rounded-xl border border-slate-200 p-2 text-slate-500 transition-colors hover:border-rose-300 hover:text-rose-500 dark:border-slate-700 dark:text-slate-400"
          >
            <X className="h-4 w-4" />
          </button>
        </div>

        <section className="shrink-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div className="flex flex-wrap items-center justify-between gap-4">
          <div>
            <h3 className="text-xs font-bold text-slate-700 dark:text-slate-200">Batch Controls</h3>
          </div>
          <div className="flex flex-wrap items-center gap-2">
            <button
              onClick={() => fileInputRef.current?.click()}
              className="flex items-center gap-2 rounded-xl border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 transition-colors hover:border-[#ff6be4] dark:border-slate-700 dark:text-slate-200"
            >
              <FilePlus2 className="h-4 w-4" />
              Add Files
            </button>
            <button
              onClick={() => void startAll()}
              disabled={
                isRunning ||
                !tasks.some(
                  (task) =>
                    task.sourceFormat !== null &&
                    (task.status === 'waiting' || task.status === 'failed')
                )
              }
              className="flex items-center gap-2 rounded-xl bg-gradient-to-r from-[#ff6be4] to-rose-500 px-3 py-2 text-xs font-semibold text-white shadow-md shadow-pink-500/20 disabled:cursor-not-allowed disabled:opacity-40"
            >
              <Play className="h-4 w-4" />
              Start All
            </button>
            <button
              onClick={clearCompleted}
              disabled={completedCount === 0}
              className="rounded-xl border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-600 disabled:opacity-40 dark:border-slate-700 dark:text-slate-300"
            >
              Clear Completed
            </button>
            <input
              ref={fileInputRef}
              type="file"
              multiple
              accept=".json,.csv,.xml,.yaml,.yml,.md,.xlsx,.xls"
              className="hidden"
              onChange={(event) => {
                if (event.currentTarget.files) addFiles(event.currentTarget.files);
                event.currentTarget.value = '';
              }}
            />
          </div>
        </div>

        <div className="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4 dark:border-slate-800">
          <div className="flex items-center gap-2">
            <span className="text-xs font-semibold text-slate-500">Target Format</span>
            <select
              value={targetFormat}
              onChange={(event) => setTargetFormat(event.target.value as DataFormat)}
              className="rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-semibold capitalize text-slate-700 outline-none focus:border-[#ff6be4] dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
            >
              {TARGET_FORMATS.map((format) => (
                <option key={format} value={format}>{format}</option>
              ))}
            </select>
          </div>
          <span className="text-xs text-slate-500">
            {tasks.length} files · {completedCount} completed
          </span>
        </div>
      </section>

      <section
        onDragOver={(event) => {
          event.preventDefault();
          setIsDragging(true);
        }}
        onDragLeave={(event) => {
          if (!event.currentTarget.contains(event.relatedTarget as Node)) {
            setIsDragging(false);
          }
        }}
        onDrop={(event) => {
          event.preventDefault();
          setIsDragging(false);
          addFiles(event.dataTransfer.files);
        }}
        className={`rounded-2xl border-2 border-dashed p-5 text-center transition-colors ${
          isDragging
            ? 'border-[#ff6be4] bg-pink-50/70 dark:bg-pink-950/20'
            : 'border-slate-200 bg-white/60 dark:border-slate-800 dark:bg-slate-900/40'
        }`}
      >
        <FilePlus2 className="mx-auto h-5 w-5 text-[#ff6be4]" />
        <p className="mt-2 text-xs font-semibold text-slate-600 dark:text-slate-300">
          Drop files here or use Add Files
        </p>
        <p className="mt-1 text-[11px] text-slate-400">
          JSON, CSV, XML, YAML, Markdown, XLSX and XLS
        </p>
      </section>

      <section className="grid min-h-[520px] flex-1 grid-cols-1 gap-5 lg:grid-cols-12">
        <div className="flex min-h-0 flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900 lg:col-span-4">
          <div className="flex items-center justify-between border-b border-slate-200 px-4 py-3 dark:border-slate-800">
            <h3 className="text-xs font-bold text-slate-700 dark:text-slate-200">File Queue</h3>
            <span className="text-[11px] text-slate-400">{tasks.length} items</span>
          </div>
          <div className="min-h-[300px] flex-1 overflow-y-auto p-2">
            {tasks.length === 0 ? (
              <div className="flex h-full min-h-[260px] items-center justify-center text-center text-xs text-slate-400">
                No files added yet.
              </div>
            ) : tasks.map((task) => (
              <div
                key={task.id}
                className={`mb-1 flex items-center gap-2 rounded-xl border p-2.5 transition-colors ${
                  activeTaskId === task.id
                    ? 'border-pink-300 bg-pink-50/70 dark:border-pink-900 dark:bg-pink-950/20'
                    : 'border-transparent hover:bg-slate-50 dark:hover:bg-slate-800/60'
                }`}
              >
                <button
                  onClick={() => setActiveTaskId(task.id)}
                  className="min-w-0 flex-1 text-left"
                >
                  <span className="block truncate text-xs font-semibold text-slate-700 dark:text-slate-200">
                    {task.name}
                  </span>
                  <span className="mt-1 block text-[10px] text-slate-400">
                    {task.sourceFormat?.toUpperCase() ?? 'UNSUPPORTED'} · {formatSize(task.size)} · {statusLabel[task.status]}
                  </span>
                </button>
                {statusIcon(task.status)}
                {task.status === 'completed' && (
                  <button
                    onClick={() => downloadTask(task)}
                    title="Download converted file"
                    className="rounded-lg p-1.5 text-slate-400 hover:text-[#ff6be4]"
                  >
                    <Download className="h-4 w-4" />
                  </button>
                )}
                <button
                  onClick={() => removeTask(task.id)}
                  title="Remove file"
                  className="rounded-lg p-1.5 text-slate-400 hover:text-rose-500"
                >
                  <Trash2 className="h-4 w-4" />
                </button>
              </div>
            ))}
          </div>
        </div>

        <div className="flex min-h-0 flex-col gap-5 lg:col-span-8">
          <div className="flex min-h-[240px] flex-1 flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <div className="flex items-center gap-2 border-b border-slate-200 px-4 py-3 dark:border-slate-800">
              <FileText className="h-4 w-4 text-[#ff6be4]" />
              <h3 className="text-xs font-bold text-slate-700 dark:text-slate-200">Source Preview</h3>
              <span className="ml-auto max-w-[55%] truncate text-[10px] text-slate-400">
                {activeTask?.name ?? 'Select a file'}
              </span>
            </div>
            <pre className="min-h-[190px] flex-1 overflow-auto whitespace-pre-wrap break-words p-4 font-mono text-[11px] leading-relaxed text-slate-600 dark:text-slate-300">
              {activeTask
                ? activeTask.sourcePreview || 'Source preview is available after conversion starts.'
                : 'Select a file from the queue to inspect it.'}
            </pre>
          </div>

          <div className="flex min-h-[240px] flex-1 flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <div className="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 px-4 py-3 dark:border-slate-800">
              <h3 className="text-xs font-bold text-slate-700 dark:text-slate-200">Converted Output</h3>
              <div className="flex items-center gap-2">
                {activeTask && (
                  <span className="text-[10px] text-slate-400">
                    {activeTask.recordCount} records
                  </span>
                )}
                {activeTask?.status === 'completed' && (
                  <button
                    onClick={() => downloadTask(activeTask)}
                    className="flex items-center gap-1 rounded-lg bg-gradient-to-r from-[#ff6be4] to-rose-500 px-2.5 py-1.5 text-[10px] font-semibold text-white"
                  >
                    <Download className="h-3.5 w-3.5" />
                    Download
                  </button>
                )}
              </div>
            </div>
            <pre className="min-h-[190px] flex-1 overflow-auto whitespace-pre-wrap break-words p-4 font-mono text-[11px] leading-relaxed text-slate-600 dark:text-slate-300">
              {activeTask?.error
                ? `Conversion error: ${activeTask.error}`
                : activeTask?.outputText || 'Converted output will appear here.'}
            </pre>
          </div>
        </div>
      </section>
      </aside>
    </div>
  );
}
