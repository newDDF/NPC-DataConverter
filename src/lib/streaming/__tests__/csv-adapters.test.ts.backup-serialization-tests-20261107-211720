// @vitest-environment jsdom

import { describe, expect, it } from 'vitest';
import { CsvReader } from '../readers/csv-reader';
import { CsvWriter } from '../writers/csv-writer';
import type {
  StreamingOutputSink,
} from '../core/contracts';

class MemorySink implements StreamingOutputSink {
  chunks: string[] = [];
  closed = false;
  aborted = false;

  async write(data: string | Uint8Array): Promise<void> {
    this.chunks.push(
      typeof data === 'string'
        ? data
        : new TextDecoder().decode(data),
    );
  }

  async close(): Promise<void> {
    this.closed = true;
  }

  async abort(): Promise<void> {
    this.aborted = true;
  }

  get output(): string {
    return this.chunks.join('');
  }
}

describe('CsvReader', () => {
  it('reads CSV records in batches', async () => {
    const file = new File(
      ['name,age\nAlice,30\nBob,25\n'],
      'people.csv',
      { type: 'text/csv' },
    );

    const reader = new CsvReader();
    const batches = [];

    for await (const batch of reader.read(file)) {
      batches.push(batch);
    }

    expect(batches.flatMap((batch) => batch.rows)).toEqual([
      { name: 'Alice', age: 30 },
      { name: 'Bob', age: 25 },
    ]);
  });

  it('supports cancellation after receiving a batch', async () => {
    const content = [
      'name,value',
      ...Array.from(
        { length: 10000 },
        (_, index) => `row-${index},${index}`,
      ),
    ].join('\n');

    const file = new File([content], 'large.csv');
    const controller = new AbortController();
    const reader = new CsvReader();
    const iterator = reader.read(file, {
      signal: controller.signal,
    })[Symbol.asyncIterator]();

    const first = await iterator.next();

    expect(first.done).toBe(false);
    expect(first.value?.rows.length).toBeGreaterThan(0);

    controller.abort();

    const next = await iterator.next();

    expect(next.done).toBe(true);
  });

  it('cleans up when the consumer exits early', async () => {
    const content = [
      'name,value',
      ...Array.from(
        { length: 10000 },
        (_, index) => `row-${index},${index}`,
      ),
    ].join('\\n');

    const file = new File([content], 'early-exit.csv');
    const reader = new CsvReader();
    const iterator = reader.read(file)[Symbol.asyncIterator]();

    const first = await iterator.next();

    expect(first.done).toBe(false);

    const result = await iterator.return!();

    expect(result.done).toBe(true);
  });

  it('rejects an already aborted signal', async () => {
    const file = new File(['name\nAlice'], 'people.csv');
    const controller = new AbortController();

    controller.abort();

    const reader = new CsvReader();
    const iterator = reader.read(file, {
      signal: controller.signal,
    })[Symbol.asyncIterator]();

    await expect(iterator.next()).rejects.toMatchObject({
      name: 'AbortError',
    });
  });
});

describe('CsvWriter', () => {
  it('writes multiple batches with one header', async () => {
    const sink = new MemorySink();
    const writer = new CsvWriter();
    const session = await writer.create(sink);

    await session.write([
      { name: 'Alice', age: 30 },
    ]);

    await session.write([
      { name: 'Bob', age: 25 },
    ]);

    await session.close();

    expect(sink.closed).toBe(true);
    expect(sink.output).toBe(
      'name,age\r\nAlice,30\r\nBob,25\r\n',
    );
    expect(sink.output.match(/name,age/g)).toHaveLength(1);
  });

  it('fills missing columns with empty values in later batches', async () => {
    const sink = new MemorySink();
    const writer = new CsvWriter();
    const session = await writer.create(sink);

    await session.write([
      { name: 'Alice', age: 30, city: 'London' },
    ]);

    await session.write([
      { name: 'Bob' },
    ]);

    await session.close();

    expect(sink.output).toBe(
      'name,age,city\r\nAlice,30,London\r\nBob,,\r\n',
    );
  });

  it('rejects columns introduced after the first batch', async () => {
    const sink = new MemorySink();
    const writer = new CsvWriter();
    const session = await writer.create(sink);

    await session.write([
      { name: 'Alice', age: 30 },
    ]);

    const outputBeforeUnexpectedColumn = sink.output;

    await expect(
      session.write([
        { name: 'Bob', age: 25, email: 'bob@example.com' },
      ]),
    ).rejects.toThrow('Unexpected CSV column: email');

    expect(sink.output).toBe(outputBeforeUnexpectedColumn);

    await session.abort();
  });

  it('escapes commas, quotes and line breaks', async () => {
    const sink = new MemorySink();
    const writer = new CsvWriter();
    const session = await writer.create(sink);

    await session.write([
      {
        text: 'hello, world',
        quote: 'say "hello"',
        multiline: 'line 1\nline 2',
      },
    ]);

    await session.close();

    expect(sink.output).toContain('"hello, world"');
    expect(sink.output).toContain('"say ""hello"""');
    expect(sink.output).toContain('"line 1\nline 2"');
  });

  it('handles empty batches', async () => {
    const sink = new MemorySink();
    const writer = new CsvWriter();
    const session = await writer.create(sink);

    await session.write([]);
    await session.close();

    expect(sink.closed).toBe(true);
    expect(sink.output).toBe('');
  });

  it('aborts the output sink', async () => {
    const sink = new MemorySink();
    const writer = new CsvWriter();
    const session = await writer.create(sink);

    await session.abort();

    expect(sink.aborted).toBe(true);
    expect(sink.closed).toBe(false);
  });
});
