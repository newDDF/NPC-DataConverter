// @vitest-environment node

import { describe, expect, it } from 'vitest';
import { XmlReader } from '../readers/xml-reader';

const collectRows = async (file: File, batchSize?: number) => {
  const reader = new XmlReader();
  const rows: Record<string, unknown>[] = [];

  for await (const batch of reader.read(file, { batchSize })) {
    rows.push(...batch.rows);
  }

  return rows;
};

function createStreamFile(
  chunks: Uint8Array[],
  onCancel?: () => void,
): File {
  const file = new File([], 'chunked.xml');

  Object.defineProperty(file, 'stream', {
    configurable: true,
    value: () =>
      new ReadableStream<Uint8Array>({
        start(controller) {
          for (const chunk of chunks) {
            controller.enqueue(chunk);
          }

          controller.close();
        },
        cancel() {
          onCancel?.();
        },
      }),
  });

  return file;
}

describe('XmlReader', () => {
  it('reads direct children as records and maps attributes', async () => {
    const file = new File(
      [
        '<records><item id="1" active="true"><name>Alice</name><age>30</age></item><item id="2"><name>Bob</name></item></records>',
      ],
      'records.xml',
    );

    expect(await collectRows(file)).toEqual([
      {
        '@id': '1',
        '@active': 'true',
        name: 'Alice',
        age: '30',
      },
      {
        '@id': '2',
        name: 'Bob',
      },
    ]);
  });

  it('maps repeated child elements to arrays', async () => {
    const file = new File(
      [
        '<records><item><tag>a</tag><tag>b</tag><tag>c</tag></item></records>',
      ],
      'repeated.xml',
    );

    expect(await collectRows(file)).toEqual([
      {
        tag: ['a', 'b', 'c'],
      },
    ]);
  });

  it('preserves mixed text and CDATA content', async () => {
    const file = new File(
      ['<records><item>Hello<![CDATA[ <world>]]>!</item></records>'],
      'cdata.xml',
    );

    expect(await collectRows(file)).toEqual([
      { value: 'Hello <world>!' },
    ]);
  });

  it('preserves whitespace in leaf text', async () => {
    const file = new File(
      ['<records><item>  keep spaces  </item></records>'],
      'whitespace.xml',
    );

    expect(await collectRows(file)).toEqual([
      { value: '  keep spaces  ' },
    ]);
  });

  it('wraps empty elements as empty strings', async () => {
    const file = new File(
      ['<records><item><name/></item></records>'],
      'empty.xml',
    );

    expect(await collectRows(file)).toEqual([
      { name: '' },
    ]);
  });

  it('splits rows into configured batch sizes', async () => {
    const file = new File(
      [
        '<records><item>1</item><item>2</item><item>3</item><item>4</item><item>5</item></records>',
      ],
      'batch.xml',
    );

    const sizes: number[] = [];

    for await (const batch of new XmlReader().read(file, { batchSize: 2 })) {
      sizes.push(batch.rows.length);
    }

    expect(sizes).toEqual([2, 2, 1]);
  });

  it('handles UTF-8 characters split across stream chunks', async () => {
    const bytes = new TextEncoder().encode(
      '<records><item>東京😀</item></records>',
    );

    const splitAt = bytes.findIndex((byte, index) => {
      return byte >= 0xf0 && byte <= 0xf4 && index > 0;
    }) + 2;

    const file = createStreamFile([
      bytes.slice(0, splitAt),
      bytes.slice(splitAt),
    ]);

    expect(await collectRows(file)).toEqual([
      { value: '東京😀' },
    ]);
  });

  it('rejects malformed XML', async () => {
    const file = new File(
      ['<records><item>broken</records>'],
      'invalid.xml',
    );

    await expect(collectRows(file)).rejects.toThrow();
  });

  it('rejects an already aborted signal', async () => {
    const file = new File(
      ['<records><item>1</item></records>'],
      'aborted.xml',
    );

    const controller = new AbortController();
    controller.abort();

    const iterator = new XmlReader().read(file, {
      signal: controller.signal,
    });

    await expect(iterator[Symbol.asyncIterator]().next()).rejects.toMatchObject({
      name: 'AbortError',
    });
  });

  it('rejects invalid batch sizes', async () => {
    const file = new File(['<records/>'], 'empty.xml');

    const iterator = new XmlReader().read(file, { batchSize: 0 });

    await expect(iterator[Symbol.asyncIterator]().next()).rejects.toThrow(
      'batchSize must be a positive integer.',
    );
  });

  it('cancels the source stream when the consumer exits early', async () => {
    let cancelled = false;

    const file = createStreamFile(
      [
        new TextEncoder().encode(
          '<records><item>1</item><item>2</item><item>3</item></records>',
        ),
      ],
      () => {
        cancelled = true;
      },
    );

    for await (const batch of new XmlReader().read(file, { batchSize: 1 })) {
      expect(batch.rows).toHaveLength(1);
      break;
    }

    expect(cancelled).toBe(true);
  });

  it('returns no records for a root element without children', async () => {
    const file = new File(['<records/>'], 'empty.xml');

    expect(await collectRows(file)).toEqual([]);
  });
});
