import type { StreamingRecord } from './contracts';

export const normalizeRecords = (value: unknown): StreamingRecord[] => {
  if (value === null || value === undefined) {
    return [];
  }

  const values = Array.isArray(value) ? value : [value];

  return values.map((item): StreamingRecord => {
    if (
      item !== null &&
      typeof item === 'object' &&
      !Array.isArray(item)
    ) {
      return item as StreamingRecord;
    }

    return { value: item };
  });
};

export const flattenRecord = (
  record: StreamingRecord,
  prefix = '',
): StreamingRecord => {
  const result: StreamingRecord = {};

  for (const key of Object.keys(record)) {
    const path = prefix ? `${prefix}.${key}` : key;
    const value = record[key];

    if (
      value !== null &&
      typeof value === 'object' &&
      !Array.isArray(value) &&
      !(value instanceof Date)
    ) {
      Object.assign(
        result,
        flattenRecord(value as StreamingRecord, path),
      );
    } else if (Array.isArray(value)) {
      result[path] = JSON.stringify(value);
    } else {
      result[path] = value;
    }
  }

  return result;
};
