import Papa from 'papaparse';
import type {
  StreamingWorkerRequest,
  StreamingWorkerResponse,
} from '@/lib/streaming/types';

type WritableFile = {
  write(data: string): Promise<void>;
  close(): Promise<void>;
  abort(): Promise<void>;
};

type LocalFileHandle = {
  createWritable(): Promise<WritableFile>;
};

type LocalDirectoryHandle = {
  getFileHandle(
    name: string,
    options: { create: boolean },
  ): Promise<LocalFileHandle>;
  removeEntry(name: string): Promise<void>;
};

type LocalStorage = {
  getDirectory(): Promise<LocalDirectoryHandle>;
};

const workerScope = self as unknown as {
  onmessage: ((
    event: MessageEvent<File | StreamingWorkerRequest>,
  ) => void) | null;
  postMessage(message: StreamingWorkerResponse): void;
};

let conversionStarted = false;
let requestCancellation: (() => void) | null = null;

const isCancelRequest = (
  value: File | StreamingWorkerRequest,
): value is StreamingWorkerRequest => {
  return (
    typeof value === 'object' &&
    value !== null &&
    'type' in value &&
    value.type === 'cancel'
  );
};

const runConversion = async (file: File) => {
  let chunks = 0;
  let rows = 0;
  let parseErrors = 0;
  let processedBytes = 0;
  let outputBytes = 0;

  let cancelRequested = false;
  let terminal = false;
  let storageReady = false;
  let writeInFlight = false;
  let outputFileCreated = false;
  let firstChunk = true;

  let parserRef: Papa.Parser | null = null;
  let directory: LocalDirectoryHandle | null = null;
  let writable: WritableFile | null = null;

  let cleanupPromise: Promise<void> | null = null;

  const encoder = new TextEncoder();
  const fileName = `streaming-output-${Date.now()}-${Math.random()
    .toString(36)
    .slice(2, 8)}.json`;

  const removeOutputFile = async () => {
    if (!directory || !outputFileCreated) return;

    try {
      await directory.removeEntry(fileName);
      outputFileCreated = false;
    } catch {
      // Ignore missing files or cleanup errors.
    }
  };

  const cleanup = async (abortWritable: boolean) => {
    if (cleanupPromise) {
      await cleanupPromise;
      return;
    }

    cleanupPromise = (async () => {
      if (abortWritable && writable) {
        try {
          await writable.abort();
        } catch {
          // The writable may already be closed or aborted.
        }
      }

      writable = null;
      await removeOutputFile();
    })();

    await cleanupPromise;
  };

  const finishCancelled = async () => {
    if (terminal) return;

    terminal = true;
    parserRef?.abort();

    await cleanup(true);

    workerScope.postMessage({
      type: 'cancelled',
    });
  };

  const finishError = async (message: string) => {
    if (terminal) return;

    terminal = true;
    parserRef?.abort();

    await cleanup(true);

    workerScope.postMessage({
      type: 'error',
      message,
    });
  };

  requestCancellation = () => {
    if (terminal) return;

    cancelRequested = true;

    if (storageReady && !writeInFlight) {
      parserRef?.abort();
      void finishCancelled();
    }
  };

  try {
    const storage = navigator.storage as unknown as LocalStorage;

    directory = await storage.getDirectory();

    if (cancelRequested) {
      await finishCancelled();
      return;
    }

    const outputFile = await directory.getFileHandle(fileName, {
      create: true,
    });

    outputFileCreated = true;

    if (cancelRequested) {
      await finishCancelled();
      return;
    }

    writable = await outputFile.createWritable();

    writeInFlight = true;
    await writable.write('[');
    outputBytes = 1;
    writeInFlight = false;
    storageReady = true;

    if (cancelRequested) {
      await finishCancelled();
      return;
    }

    Papa.parse<Record<string, string>>(file, {
      header: true,
      skipEmptyLines: 'greedy',
      chunkSize: 1024 * 1024,
      worker: false,

      chunk(results, parser) {
        parserRef = parser;

        if (terminal || cancelRequested) {
          parser.abort();
          return;
        }

        parser.pause();
        writeInFlight = true;

        void (async () => {
          try {
            chunks += 1;
            rows += results.data.length;
            parseErrors += results.errors.length;

            processedBytes = Math.min(
              file.size,
              results.meta.cursor ?? processedBytes,
            );

            if (results.data.length > 0) {
              const serialized = results.data
                .map((row) => JSON.stringify(row))
                .join(',');

              const output = firstChunk
                ? serialized
                : `,${serialized}`;

              await writable?.write(output);

              outputBytes += encoder.encode(output).byteLength;
              firstChunk = false;
            }

            writeInFlight = false;

            if (cancelRequested) {
              await finishCancelled();
              return;
            }

            if (terminal) return;

            workerScope.postMessage({
              type: 'progress',
              chunks,
              rows,
              parseErrors,
              processedBytes,
              totalBytes: file.size,
              outputBytes,
            });

            parser.resume();
          } catch (error) {
            writeInFlight = false;

            if (cancelRequested) {
              await finishCancelled();
              return;
            }

            await finishError(
              error instanceof Error
                ? error.message
                : 'Unable to write JSON output.',
            );
          }
        })();
      },

      complete() {
        if (terminal) return;

        if (cancelRequested) {
          void finishCancelled();
          return;
        }

        writeInFlight = true;

        void (async () => {
          try {
            await writable?.write(']');
            outputBytes += 1;

            if (cancelRequested) {
              writeInFlight = false;
              await finishCancelled();
              return;
            }

            await writable?.close();
            writable = null;
            writeInFlight = false;

            if (cancelRequested) {
              await finishCancelled();
              return;
            }

            if (terminal) return;

            terminal = true;

            workerScope.postMessage({
              type: 'complete',
              chunks,
              rows,
              parseErrors,
              outputBytes,
              fileName,
            });
          } catch (error) {
            writeInFlight = false;

            if (cancelRequested) {
              await finishCancelled();
              return;
            }

            await finishError(
              error instanceof Error
                ? error.message
                : 'Unable to finalize JSON output.',
            );
          }
        })();
      },

      error(error) {
        if (terminal) return;

        if (cancelRequested) {
          void finishCancelled();
          return;
        }

        void finishError(error.message || 'CSV parsing failed.');
      },
    });

  } catch (error) {
    if (cancelRequested) {
      await finishCancelled();
      return;
    }

    await finishError(
      error instanceof Error
        ? error.message
        : 'Unable to initialize local output storage.',
    );
  }
};

workerScope.onmessage = (event) => {
  const message = event.data;

  if (isCancelRequest(message)) {
    requestCancellation?.();
    return;
  }

  if (!(message instanceof File)) {
    workerScope.postMessage({
      type: 'error',
      message: 'Invalid input file.',
    });
    return;
  }

  if (conversionStarted) return;

  conversionStarted = true;
  void runConversion(message);
};
