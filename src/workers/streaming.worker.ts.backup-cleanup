import Papa from 'papaparse';
import type { StreamingWorkerResponse } from '@/lib/streaming/types';

type WritableFile = {
  write(data: string): Promise<void>;
  close(): Promise<void>;
  abort(): Promise<void>;
};

type LocalFileHandle = {
  createWritable(): Promise<WritableFile>;
};

type LocalDirectoryHandle = {
  getFileHandle(
    name: string,
    options: { create: boolean },
  ): Promise<LocalFileHandle>;
};

type LocalStorage = {
  getDirectory(): Promise<LocalDirectoryHandle>;
};

const workerScope = self as unknown as {
  onmessage: ((event: MessageEvent<File>) => void) | null;
  postMessage(message: StreamingWorkerResponse): void;
};

workerScope.onmessage = async (event) => {
  const file = event.data;

  if (!(file instanceof File)) {
    workerScope.postMessage({
      type: 'error',
      message: 'Invalid input file.',
    });
    return;
  }

  let chunks = 0;
  let rows = 0;
  let parseErrors = 0;
  let processedBytes = 0;
  let outputBytes = 0;
  let failed = false;
  let firstChunk = true;

  let writable: WritableFile | null = null;

  const encoder = new TextEncoder();
  const fileName = `streaming-output-${Date.now()}.json`;

  try {
    const storage = navigator.storage as unknown as LocalStorage;
    const directory = await storage.getDirectory();
    const outputFile = await directory.getFileHandle(fileName, {
      create: true,
    });

    writable = await outputFile.createWritable();

    await writable.write('[');
    outputBytes = 1;

    Papa.parse<Record<string, string>>(file, {
      header: true,
      skipEmptyLines: 'greedy',
      chunkSize: 1024 * 1024,
      worker: false,

      chunk(results, parser) {
        if (failed) return;

        parser.pause();

        void (async () => {
          try {
            chunks += 1;
            rows += results.data.length;
            parseErrors += results.errors.length;
            processedBytes = Math.min(
              file.size,
              results.meta.cursor ?? processedBytes,
            );

            if (results.data.length > 0) {
              const serialized = results.data
                .map((row) => JSON.stringify(row))
                .join(',');

              const output = firstChunk
                ? serialized
                : `,${serialized}`;

              await writable?.write(output);

              outputBytes += encoder.encode(output).byteLength;
              firstChunk = false;
            }

            workerScope.postMessage({
              type: 'progress',
              chunks,
              rows,
              parseErrors,
              processedBytes,
              totalBytes: file.size,
              outputBytes,
            });

            parser.resume();
          } catch (error) {
            failed = true;
            parser.abort();

            await writable?.abort();

            workerScope.postMessage({
              type: 'error',
              message: error instanceof Error
                ? error.message
                : 'Unable to write JSON output.',
            });
          }
        })();
      },

      complete() {
        if (failed) return;

        void (async () => {
          try {
            await writable?.write(']');
            outputBytes += 1;

            await writable?.close();

            workerScope.postMessage({
              type: 'complete',
              chunks,
              rows,
              parseErrors,
              outputBytes,
              fileName,
            });
          } catch (error) {
            workerScope.postMessage({
              type: 'error',
              message: error instanceof Error
                ? error.message
                : 'Unable to finalize JSON output.',
            });
          }
        })();
      },

      error(error) {
        if (failed) return;
        failed = true;

        void writable?.abort();

        workerScope.postMessage({
          type: 'error',
          message: error.message || 'CSV parsing failed.',
        });
      },
    });
  } catch (error) {
    await writable?.abort().catch(() => undefined);

    workerScope.postMessage({
      type: 'error',
      message: error instanceof Error
        ? error.message
        : 'Unable to initialize local output storage.',
    });
  }
};
